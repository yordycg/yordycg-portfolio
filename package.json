{
  "name": "yordycg-portfolio",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio built with vanilla HTML, CSS and JavaScript. npm is used only for development tooling.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "serve": "node scripts/serve.mjs",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "html": "html-validate src/index.html src/404.html",
    "links": "node scripts/check-links.mjs",
    "a11y": "node scripts/qa-a11y.mjs",
    "lighthouse": "lhci autorun",
    "og": "bash scripts/og.sh",
    "audit:runtime": "npm audit --omit=dev",
    "check": "npm run lint && npm run format:check && npm run html"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.2",
    "@lhci/cli": "0.15.1",
    "browser-sync": "3.0.4",
    "html-validate": "11.17.0",
    "linkinator": "8.1.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "sharp-cli": "6.1.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
